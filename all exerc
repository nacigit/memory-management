#include <stdlib.h>

int	str_len(char *str);
int	ft_power(int nb, int power);

int	get_index(char *base, char c)
{
	int (i) = 0;
	int (base_len) = str_len(base);
	while (i < base_len)
	{
		if (c == base[i])
			return (i);
		i++;
	}
	return (-1);
}

int	str_to_int(char *str, char *base_from)
{
	int (i) = 0;
	int (sign) = 1;
	int (index) = 0;
	int (result_nbr) = 0;
	int (base_len) = str_len(base_from);
	while (str[i])
	{
		while ((str[i] >= 9 && str[i] <= 13) || str[i] == ' '
			|| str[i] == '+' || str[i] == '-')
		{
			if (str[i] == '-')
				sign *= -1;
			i++;
		}
		while (str[i])
		{
			index = get_index(base_from, str[i]);
			result_nbr += (index * ft_power(base_len, str_len(str) - 1 - i));
			i++;
		}
	}
	return (result_nbr * sign);
}

int	ft_outsize(int nbr, int base_len)
{
	int	count;

	count = -1;
	if (nbr == 0)
		count = 0;
	while (nbr > 0)
	{
		nbr /= base_len;
		count++;
	}
	return (count);
}

char	*int_to_str(int nbr, char *base_to)
{
	int (powerbase) = 0;
	int (negative) = 0;
	int (i) = 0;
	if (nbr < 0)
	{
		negative = 1;
		nbr = -nbr;
		i = 1;
	}
	int (base_size) = str_len(base_to);
	int (outlen) = ft_outsize(nbr, base_size);
	char *(output) = malloc(sizeof(char) * (outlen + 1 + negative));
	while (nbr >= 0 && outlen >= 0)
	{
		powerbase = ft_power(base_size, outlen);
		output[i] = base_to[nbr / powerbase];
		if (powerbase <= nbr)
			nbr %= ft_power(base_size, outlen);
		i++;
		outlen--;
	}
	if (negative == 1)
		output[0] = '-';
	output[i] = '\0';
	return (output);
}
