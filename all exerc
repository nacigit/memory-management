#include <stdio.h>
#include <stdlib.h>

int	ft_is_sep(char c, char *seps)
{
	int	i;

	i = 0;
	while (seps[i])
	{
		if (c == seps[i])
			return (1);
		i++;
	}
	return (0);
}

int	ft_size(char *str, int startind, char *seps)
{
	int (i) = startind;
	int (size) = 1;
	while (str[i] && !ft_is_sep(i++, seps))
		size++;
	return (size);
}

int	ft_wrdcount(char *str, char *seps)
{
	int (wordcnt) = 0;
	int (i) = 0;
	while (str[i])
	{
		if (ft_is_sep(str[i], seps) == 0)
		{
			wordcnt++;
			while (ft_is_sep(str[i], seps) == 0 && str[i])
				i++;
		}
		else if (ft_is_sep(str[i], seps) == 1 && str[i])
			i++;
	}
	return (wordcnt);
}

char	**ft_split(char *str, char *seps)
{
	char	**rslt;

	int (startind) = 0;
	int (letterind) = 0;
	int (w_ind) = 0;
	int (i) = 0;
	rslt = malloc((sizeof(char *) * (ft_wrdcount(str, seps)) + 1));
	while (str[i] && rslt != NULL)
	{
		if (ft_is_sep(str[i], seps) == 0)
		{
			startind = i;
			rslt[w_ind] = malloc(ft_size(str, startind, seps));
			while (!ft_is_sep(str[i], seps) && str[i])
				rslt[w_ind][letterind++] = str[i++];
			rslt[w_ind][letterind] = '\0';
			letterind = 0;
			w_ind++;
		}
		else
			i++;
	}
	rslt[i] = NULL;
	return (rslt);
}
