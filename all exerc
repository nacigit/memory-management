#include <stdlib.h>

int		str_to_int(char *str, char *base_from);
char	*int_to_str(int nbr, char *base_to);
int		get_index(char *base, char c);

int	str_len(char *str)
{
	int	i;

	i = 0;
	while (str[i])
		i++;
	return (i);
}

int	ft_power(int nb, int power)
{
	if (power < 0)
		return (0);
	if (power > 0)
		return (nb * ft_power(nb, power - 1));
	return (1);
}

int	basecheck(char *base)
{
	int (i) = 0;
	int (j) = 0;
	while (base[i])
	{
		if (base[i] == '+' || base[i] == '-'
			|| (base[i] >= 9 && base[i] <= 13)
			|| base[i] == ' ')
			return (0);
		j = i + 1;
		while (base[j])
		{
			if (base[j] == base[i])
				return (0);
			j++;
		}
		i++;
	}
	return ((!base[0] + !base[1]) == 0);
}

char	*ft_convert_base(char *nbr, char *base_from, char *base_to)
{
	char	*result;
	int		number;

	if (basecheck(base_from) == 0 || basecheck(base_to) == 0)
		return (NULL);
	number = str_to_int(nbr, base_from);
	result = int_to_str(number, base_to);
	if (!result)
		return (NULL);
	return (result);
}
