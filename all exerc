#include <stdlib.h>
#include <stdio.h>

int	ft_strlen(char *str)
{
	int	i;

	i = 0;
	while (str[i])
	{
		i++;
	}
	return (i);
}

int	ft_charcounter(int size, char **strs, char *sep)
{
	int	charamount;
	int	i;

	i = 0;
	charamount = 0;
	while (i < size)
		charamount += ft_strlen(strs[i++]);
	if (size > 1)
		charamount = charamount + ((size - 1) * ft_strlen(sep));
	return (charamount);
}

void	joiner(int size, char **strs, char *output, char *sep)
{
	int (charnbr) = ft_charcounter(size, strs, sep);
	int (strindex) = 0;
	int (letter);
	int (i) = 0;
	int (s) = 0;
	while (i < charnbr)
	{
		while (strindex < size)
		{
			letter = 0;
			while (strs[strindex][letter])
				output[i++] = strs[strindex][letter++];
			if (strs[strindex + 1])
			{
				s = 0;
				while (sep[s])
					output[i++] = sep[s++];
			}
			strindex++;
		}
		i++;
	}
	output[i] = '\0';
}

char	*ft_strjoin(int size, char **strs, char *sep)
{
	char	*output;
	int		charnbr;

	charnbr = ft_charcounter(size, strs, sep);
	output = malloc(sizeof(char) * charnbr + 1);
	if (!output)
		return (NULL);
	joiner(size, strs, output, sep);
	return (output);
}
