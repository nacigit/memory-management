#include <stdlib.h>

char	*ft_strdup(char *src)
{
	char	*copy;
	int		size;
	int		i;

	i = 0;
	size = 0;
	while (src[i])
		i++;
	size = i;
	copy = malloc(size * (sizeof(char) + 1));
	if (copy == NULL || src == NULL)
		return (NULL);
	i = 0;
	while (i <= size)
	{
		copy[i] = src[i];
		i++;
	}
	return (copy);
}
